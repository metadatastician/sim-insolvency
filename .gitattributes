# Repo-specific .gitattributes.
#
# Replaces an unmodified RSR template that configured diff drivers for
# Rust, Elixir, Julia, ReScript, Ada, Haskell, Chapel, Scheme, Nickel and
# Nix — none of which this repo uses — while configuring none of the
# languages it actually contains, and declared lowercase `justfile` while
# this repo ships `Justfile`.
#
# No Nix/flake entries appear below: 0-AI-MANIFEST.adoc forbids a Nix flake
# and tools/check-no-prohibited-stack.sh fails the build on flake.nix.

* text=auto eol=lf

# Source — languages this repo actually uses
*.zig     text eol=lf
*.idr     text eol=lf
*.ipkg    text eol=lf
*.affine  text eol=lf
*.a2ml    text eol=lf

# Docs
*.adoc  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Data / config
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Build / repo config files
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
Justfile       text eol=lf
Containerfile  text eol=lf

# Scripts
*.sh   text eol=lf

# Binary
*.wasm  binary
