interpretation = "Assessment safety rule; not a statement of comprehensive law."
pack-version = "0.1.0"
review-status = "PROVISIONAL"
test = "kernel:ethical-reasoning"
normative-legal-scoring = false

[[rule]]
id = "training-evidence-before-selection"
jurisdiction = "england-wales"
