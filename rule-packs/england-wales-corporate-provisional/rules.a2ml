source-citation = "docs/foundation/learning-model.adoc#construct"
effective-from = "2026-07-01"
interpretation = "Pedagogical evidence-use rule."
pack-version = "0.1.0"
review-status = "PROVISIONAL"
test = "kernel:selectProcedure-prerequisites"
normative-legal-scoring = false

[[rule]]
id = "legal-authority-slot-procedure-eligibility"
jurisdiction = "england-wales"
authority-source = "PRACTITIONER-REVIEW-REQUIRED"
source-citation = "UNRESOLVED"
effective-from = "2026-07-01"
interpretation = "No executable legal conclusion until citation and review are complete."
